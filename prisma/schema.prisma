generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                       @id @default(autoincrement())
  name                String?
  email               String                    @unique
  phoneNumber         String?
  dateOfBirth         DateTime?
  gender              String?
  maritalStatus       String?
  preferredLanguage   String?
  locationPincode     String?
  accountCreatedAt    DateTime?                 @default(now())
  lastLoginAt         DateTime?
  preferredCategories String[]
  hashedPassword      String?
  onboardingComplete  Boolean                   @default(false)
  autoReorders        AutoReorderSubscription[]
  cart                Cart?
  orders              Order[]
  location            Location?                 @relation(fields: [locationPincode], references: [pincode])
  authentication      UserAuthentication?
  userEvents          UserEvent[]
  searchHistory       UserSearchHistory[]
  viewHistory         UserViewHistory[]
}

model UserAuthentication {
  authId String @id
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  pincode  String @id
  district String
  city     String
  state    String
  cityTier String
  users    User[]
}

model Category {
  id              Int              @id @default(autoincrement())
  name            String
  parentId        Int?
  parent          Category?        @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryParent")
  categoryOptions CategoryOption[]
  products        Product[]        @relation("CategoryProducts")
  subProducts     Product[]        @relation("SubcategoryProducts")
}

model Product {
  id            Int                       @id @default(autoincrement())
  name          String
  description   String?
  imageUrl      String?
  brand         String?
  keywords      String[]
  averageRating Float?
  reviewCount   Int?
  categoryId    Int
  subcategoryId Int
  autoReorders  AutoReorderSubscription[]
  listings      Listing[]
  category      Category                  @relation("CategoryProducts", fields: [categoryId], references: [id])
  subcategory   Category                  @relation("SubcategoryProducts", fields: [subcategoryId], references: [id])
  properties    ProductProperty[]
  skus          SKU[]
  userEvents    UserEvent[]
  viewHistory   UserViewHistory[]
}

model Property {
  id                Int               @id @default(autoincrement())
  name              String            @unique
  productProperties ProductProperty[]
}

model ProductProperty {
  id         Int      @id @default(autoincrement())
  productId  Int
  propertyId Int
  value      String
  product    Product  @relation(fields: [productId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([productId, propertyId])
}

model Option {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  categoryOptions CategoryOption[]
  optionValues    OptionValue[]
}

model CategoryOption {
  categoryId Int
  optionId   Int
  category   Category @relation(fields: [categoryId], references: [id])
  option     Option   @relation(fields: [optionId], references: [id])

  @@id([categoryId, optionId])
}

model SKU {
  id           Int           @id @default(autoincrement())
  skuCode      String?       @unique
  productId    Int
  listings     Listing[]
  optionValues OptionValue[]
  product      Product       @relation(fields: [productId], references: [id])
}

model OptionValue {
  id       Int    @id @default(autoincrement())
  optionId Int
  skuId    Int
  value    String
  option   Option @relation(fields: [optionId], references: [id])
  sku      SKU    @relation(fields: [skuId], references: [id])

  @@unique([optionId, skuId])
}

model Seller {
  id       Int       @id @default(autoincrement())
  name     String
  listings Listing[]
}

model Listing {
  id         Int         @id @default(autoincrement())
  sellerId   Int
  skuId      Int
  productId  Int
  price      Decimal
  stockQty   Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartItems  CartItem[]
  product    Product     @relation(fields: [productId], references: [id])
  seller     Seller      @relation(fields: [sellerId], references: [id])
  sku        SKU         @relation(fields: [skuId], references: [id])
  orderItems OrderItem[]
  userEvents UserEvent[]

  @@unique([sellerId, skuId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  listingId Int
  quantity  Int
  addedAt   DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([cartId])
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  placedAt    DateTime    @default(now())
  totalAmount Decimal
  status      String
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  listingId Int
  quantity  Int
  priceEach Decimal
  listing   Listing @relation(fields: [listingId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model AutoReorderSubscription {
  id            Int      @id @default(autoincrement())
  userId        Int
  productId     Int
  intervalDays  Int
  nextOrderDate DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model UserSearchHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  query      String
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model UserViewHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model UserEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  listingId Int?
  productId Int?
  query     String?
  filters   Json?
  timestamp DateTime @default(now())
  listing   Listing? @relation(fields: [listingId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}
